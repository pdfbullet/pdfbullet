      "name": "Compress PDF",
      "shortName": "Compress",
      "url": "https://pdfbullet.com/compress-pdf",
      "chosenIconUrl": "https://pdfbullet.com/icons/icon-96x96.png"
    },
    {
      "name": "PDF to Word",
      "shortName": "PDF→Word",
      "url": "https://pdfbullet.com/pdf-to-word",
      "chosenIconUrl": "https://pdfbullet.com/icons/icon-96x96.png"
    },
    {
      "name": "Remove Background",
      "shortName": "BG Remove",
      "url": "https://pdfbullet.com/remove-background",
      "chosenIconUrl": "https://pdfbullet.com/icons/icon-96x96.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://pdfbullet.com/manifest.json",
