{
  "name": "Pdf Bullet: PDF & Image Tools",
  "short_name": "Pdf Bullet",
  "description": "The only PDF & Image toolkit you'll ever need. Merge, split, compress, convert, edit PDFs and more.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#ffffff",
  "theme_color": "#B90B06",
  "orientation": "portrait-primary",
  "lang": "en",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/desktop-view.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Pdf Bullet Homepage on a Desktop Browser"
    },
    {
      "src": "/mobile-view.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pdf Bullet Tool Selection on a Mobile Device"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.pdfbullet.app",
      "id": "com.pdfbullet.app"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/handle-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared_files",
          "accept": ["application/pdf", ".pdf", "image/jpeg", ".jpg", "image/png", ".png", "image/webp", ".webp"]
        }
      ]
    }
  },
  "iarc_rating_id": "",
  "shortcuts": [
    {
      "name": "Merge PDF files",
      "url": "/merge-pdf",
      "description": "Combine multiple PDF files into one.",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Compress PDF",
      "url": "/compress-pdf",
      "description": "Reduce the file size of your PDFs.",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "JPG to PDF",
      "url": "/jpg-to-pdf",
      "description": "Convert JPG images to PDF documents.",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    }
  ],
  "id": "/"
}
