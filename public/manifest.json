{
  "name": "PDFBullet: PDF & Image Tools",
  "short_name": "PDFBullet",
  "description": "The only PDF & Image toolkit you'll ever need. Merge, split, compress, convert, edit PDFs and more — 100% free.",
  "start_url": "/?source=pwa",
  "id": "com.pdfbullet.tools",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "tab_strip": {
    "new_tab_button": {
      "url": "/"
    },
    "home_tab": {
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "visibility": "auto"
    }
  },
  "background_color": "#B90B06",
  "theme_color": "#B90B06",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "share_target": {
    "action": "/merge-pdf",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/maskable-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/desktop-view.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PDFBullet Homepage with all PDF & Image tools"
    },
    {
      "src": "/mobile-view.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile view showing PDF tools"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "shortcuts": [
    {
      "name": "Merge PDF",
      "short_name": "Merge",
      "url": "/merge-pdf",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Compress PDF",
      "short_name": "Compress",
      "url": "/compress-pdf",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "PDF to Word",
      "short_name": "PDF→Word",
      "url": "/pdf-to-word",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Remove Background",
      "short_name": "BG Remove",
      "url": "/remove-background",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "scope_extensions": [
    {
      "origin": "pdfbullet.com"
    },
    {
      "origin": "www.pdfbullet.com"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.pdfbullet.tools",
      "id": "com.pdfbullet.tools"
    }
  ],
  "file_handlers": [
    {
      "action": "/merge-pdf",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+pdfbullet",
      "url": "/?url=%s"
    }
  ],
  "widgets": [
    {
      "name": "PDFBullet Tools",
      "short_name": "PDF Tools",
      "description": "Quick access to PDF tools",
      "tag": "pdf-tools",
      "ms_ac_template": "/widgets/template.json",
      "data": "/widgets/data.json",
      "type": "application/json"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/"
  }
}